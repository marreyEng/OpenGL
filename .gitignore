# ==========================================
# CMake Outputs and Build Directories
# ==========================================
# Ignores default build folders generated by CMake command line and IDEs
[Bb]uild/
/build*/
/out/
/cmake-build-*/

# CMake cache and generated build files
CMakeCache.txt
CMakeFiles/
CMakeScripts/
Makefile
cmake_install.cmake
install_manifest.txt
compile_commands.json

# ==========================================
# Compiler Outputs & Object Files
# ==========================================
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.dll
*.exe
*.out
*.app

# ==========================================
# IDE and Editor Specific Files
# ==========================================
# VS Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# Visual Studio
.vs/
*.user
*.suo
*.sln

# CLion / IntelliJ
.idea/

# Xcode
*.xcodeproj/
*.xcworkspace/

# ==========================================
# Operating System & Other Files
# ==========================================
.DS_Store
Thumbs.db
*.log
